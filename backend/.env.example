APP_NAME="AR Qudrix ISP OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

# ---- Database: app connection (RLS-enforced, arq_app_role) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arq_isp_os
DB_USERNAME=arq_app_role
DB_PASSWORD=

# ---- Platform-admin connection (BYPASSRLS — Super Admin console only) ----
DB_PLATFORM_USERNAME=arq_platform_admin_role
DB_PLATFORM_PASSWORD=

# ---- Redis (cache + queue + rate limit) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ---- Sanctum (SPA + mobile tokens) ----
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ---- Integration credentials (never commit real values) ----
# Payment gateways, SMS gateway, LLM API key — sourced from the secrets
# manager in production, set here only for local sandbox work.
ANTHROPIC_API_KEY=
BKASH_SANDBOX=true
